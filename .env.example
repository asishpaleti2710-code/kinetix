# ====================================================================
# AgentFlow AI - Environment Configuration
# ====================================================================

# Database: Use MySQL or fallback to SQLite for local development
# MySQL: mysql+pymysql://agentflow_user:agentflow_pass@localhost:3306/agentflow
# SQLite: sqlite:///./agentflow.db
DATABASE_URL=sqlite:///./agentflow.db

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Default LLM Model
DEFAULT_MODEL=gemini-1.5-flash

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIR=./chroma_db

# Document Ingestion Storage
UPLOAD_DIR=./uploads

# Security & Sessions
SECRET_KEY=super-secret-sales-agentic-key-9992
